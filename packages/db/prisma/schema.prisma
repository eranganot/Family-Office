// ============================================================================
// WealthOS — Prisma Schema DRAFT (for design review; not yet migrated)
// PostgreSQL. Money = Decimal(18,4) + ISO currency code. No floats. No JSONB
// for core financial fields; JSONB only for raw payloads, snapshots, matrices.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts (env DATABASE_URL), not here.
}

// ---------------------------------------------------------------------------
// Core: Household, Members, Workflow state machine, Auth
// ---------------------------------------------------------------------------


model MarketIndicator {
  id        String   @id @default(uuid())
  key       String // BOI_RATE | CPI | MORTGAGE_AVG
  value     Decimal  @db.Decimal(12, 6)
  asOf      DateTime @db.Date
  source    String // BOI
  createdAt DateTime @default(now())

  @@unique([key, asOf, source])
}

enum WorkflowState {
  MAPPING
  VERIFICATION
  ALLOCATION
  STRATEGY
  MONITORING
}

enum AllocationPlanStatus {
  PROPOSED
  APPROVED
  SUPERSEDED
}

model Household {
  id            String        @id @default(uuid())
  name          String
  baseCurrency  String        @db.Char(3) // ILS
  workflowState WorkflowState @default(MAPPING)
  locale        String        @default("he") // he | en
  timezone      String        @default("Asia/Jerusalem")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  members         FamilyMember[]
  ledgerItems     LedgerItem[]
  documents       Document[]
  goals           Goal[]
  recommendations Recommendation[]
  scenarios       Scenario[]
  snapshots       HouseholdSnapshot[]
  allocationPlans AllocationPlan[]
  transitions     WorkflowTransition[]
  auditEvents     AuditEvent[]
  assumptions     Assumption[]
  users           User[]
  monitoringRuns   MonitoringRun[]
  monitoringAlerts MonitoringAlert[]

  // M36 — Financial Operations
  cashFlowCategories CashFlowCategory[]
  transactions       Transaction[]
  operatingPeriods   OperatingPeriod[]
  calendarEvents     CalendarEvent[]
  recurringDecisions RecurringDecision[]
  actionEvents       ActionEvent[]
  mappingProfiles    ImportMappingProfile[]
}

enum MemberRole {
  ADULT
  CHILD
}

model FamilyMember {
  id               String     @id @default(uuid())
  householdId      String
  household        Household  @relation(fields: [householdId], references: [id])
  name             String
  role             MemberRole
  birthDate        DateTime?  @db.Date
  taxResidency     String     @default("IL")
  employmentStatus String? // EMPLOYED | SELF_EMPLOYED | UNEMPLOYED | RETIRED | STUDENT | MINOR
  archivedAt       DateTime?

  ownershipShares OwnershipShare[]
}

model User {
  id           String    @id @default(uuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  email        String    @unique
  passwordHash String // argon2id
  createdAt    DateTime  @default(now())
}

model WorkflowTransition {
  id          String        @id @default(uuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id])
  fromState   WorkflowState
  toState     WorkflowState
  reason      String
  at          DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Ledger: canonical financial facts (class-table inheritance)
// LedgerItem = base row: identity, provenance, verification, ownership.
// Exactly one detail row per item, matching `kind`. Never deleted, only closed.
// ---------------------------------------------------------------------------

enum LedgerKind {
  ACCOUNT // bank / brokerage / pension / gemel / hishtalmut ...
  REAL_ESTATE
  MORTGAGE
  LOAN
  CASH_FLOW // income or expense stream
  INSURANCE
  OTHER_ASSET
  OTHER_LIABILITY
  SUSPENSE // unresolved — carries no detail row
}

enum ItemStatus {
  ACTIVE
  CLOSED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  STALE
}

model LedgerItem {
  id              String             @id @default(uuid())
  householdId     String
  household       Household          @relation(fields: [householdId], references: [id])
  kind            LedgerKind
  name            String
  currency        String             @db.Char(3)
  status          ItemStatus         @default(ACTIVE)
  verification    VerificationStatus @default(UNVERIFIED)
  confidence      Int                @default(0) // 0-100
  lastConfirmedAt DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  closedAt        DateTime?

  ownershipShares OwnershipShare[]
  valuations      Valuation[]
  importedFields  ImportedField[]

  accountDetail    AccountDetail?
  realEstateDetail RealEstateDetail?
  mortgageDetail   MortgageDetail?
  loanDetail       LoanDetail?
  cashFlowDetail   CashFlowDetail?
  insuranceDetail  InsuranceDetail?

  /** B7: owner pins this account/asset to a specific goal so funding-gap math matches intent. */
  earmarkedGoalId  String?
  earmarkedGoal    Goal?              @relation("GoalEarmark", fields: [earmarkedGoalId], references: [id], onDelete: SetNull)

  suspenseResolutions SuspenseItem[]     @relation("resolution")
  evidenceFor         RecommendationEvidence[]

  @@index([householdId, kind, status])
  transactions Transaction[] // M36 (evidence link; never counted by net-worth)
}

model OwnershipShare {
  ledgerItemId   String
  ledgerItem     LedgerItem   @relation(fields: [ledgerItemId], references: [id])
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id])
  sharePct       Decimal      @db.Decimal(7, 4) // shares per item must sum to 100 (domain-enforced)

  @@id([ledgerItemId, familyMemberId])
}

enum ValuationSource {
  DOCUMENT_IMPORT
  MANUAL_ENTRY
  CALCULATED
  CONNECTOR // future
}

model Valuation {
  id           String          @id @default(uuid())
  ledgerItemId String
  ledgerItem   LedgerItem      @relation(fields: [ledgerItemId], references: [id])
  asOf         DateTime        @db.Date
  value        Decimal         @db.Decimal(18, 4)
  currency     String          @db.Char(3)
  source       ValuationSource
  confidence   Int             @default(0)
  documentId   String?
  document     Document?       @relation(fields: [documentId], references: [id])
  supersedesId String?         @unique // append-only corrections
  createdAt    DateTime        @default(now())

  importedFields ImportedField[]

  @@index([ledgerItemId, asOf])
}

// --- Detail tables (1:1 with LedgerItem, matching kind) ---------------------

enum AccountType {
  BANK_CHECKING
  BANK_SAVINGS
  BANK_DEPOSIT // pikadon
  BROKERAGE_IL
  BROKERAGE_FOREIGN
  PENSION_COMPREHENSIVE // keren pensia mekifa
  PENSION_GENERAL // keren pensia klalit
  KUPAT_GEMEL
  GEMEL_LEHASHKAA
  KEREN_HISHTALMUT
  IRA_GEMEL // kupat gemel be'nihul ishi
  FOREIGN_RETIREMENT // e.g. 401k/IRA
  CASH_OTHER
}

model AccountDetail {
  ledgerItemId       String     @id
  ledgerItem         LedgerItem @relation(fields: [ledgerItemId], references: [id])
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id])
  accountType        AccountType
  accountNumberMasked String?
  trackName          String? // maslul, e.g. "מניות", "כללי"
  /** Share (0-100) of this account held in growth assets (equity-type tracks); null = unknown → allocation engine excludes-and-reports. */
  growthSharePct   Decimal? @db.Decimal(7, 4)
  /** True when growthSharePct came from the name/type heuristic and awaits owner confirmation. */
  growthShareEstimated Boolean @default(false)
  managementFeePct   Decimal?   @db.Decimal(6, 4) // dmei nihul from balance
  depositFeePct      Decimal?   @db.Decimal(6, 4) // dmei nihul from deposits
  employerName       String?
  openedAt           DateTime?  @db.Date
  liquidityClass     String? // LIQUID | RESTRICTED | LOCKED_UNTIL(date via notes)
}

model Institution {
  id      String @id @default(uuid())
  name    String
  nameHe  String?
  country String @default("IL")
  type    String // BANK | INSURER | PENSION_COMPANY | BROKER | GOVERNMENT | OTHER

  accounts  AccountDetail[]
  documents Document[]

  @@unique([name, country])
}

model RealEstateDetail {
  ledgerItemId       String     @id
  ledgerItem         LedgerItem @relation(fields: [ledgerItemId], references: [id])
  address            String
  city               String?
  propertyType       String // APARTMENT | HOUSE | LOT | COMMERCIAL
  isPrimaryResidence Boolean    @default(false)
  purchaseDate       DateTime?  @db.Date
  purchasePrice      Decimal?   @db.Decimal(18, 4)
  purchaseCurrency   String?    @db.Char(3)

  mortgages MortgageDetail[]
}

model MortgageDetail {
  ledgerItemId   String            @id
  ledgerItem     LedgerItem        @relation(fields: [ledgerItemId], references: [id])
  lenderId       String?
  linkedPropertyId String? // RealEstateDetail.ledgerItemId
  linkedProperty RealEstateDetail? @relation(fields: [linkedPropertyId], references: [ledgerItemId])
  originalPrincipal Decimal        @db.Decimal(18, 4)
  startDate      DateTime          @db.Date

  tracks MortgageTrack[]
}

enum MortgageTrackType {
  PRIME
  FIXED_LINKED // kvua tzmuda (CPI-linked)
  FIXED_UNLINKED // kalatz
  VARIABLE_LINKED
  VARIABLE_UNLINKED
  FOREIGN_CURRENCY
}

model MortgageTrack {
  id                 String            @id @default(uuid())
  mortgageId         String
  mortgage           MortgageDetail    @relation(fields: [mortgageId], references: [ledgerItemId])
  trackType          MortgageTrackType
  principalRemaining Decimal           @db.Decimal(18, 4)
  annualRatePct      Decimal           @db.Decimal(7, 4)
  cpiLinked          Boolean
  monthlyPayment     Decimal?          @db.Decimal(18, 4)
  endDate            DateTime          @db.Date
}

model LoanDetail {
  ledgerItemId   String     @id
  ledgerItem     LedgerItem @relation(fields: [ledgerItemId], references: [id])
  lenderName     String?
  principalRemaining Decimal @db.Decimal(18, 4)
  annualRatePct  Decimal    @db.Decimal(7, 4)
  endDate        DateTime?  @db.Date
  purpose        String?
}

enum CashFlowType {
  SALARY
  SELF_EMPLOYMENT_INCOME
  RENTAL_INCOME
  PENSION_INCOME
  OTHER_INCOME
  LIVING_EXPENSE
  HOUSING_EXPENSE
  EDUCATION_EXPENSE
  INSURANCE_PREMIUM
  LOAN_PAYMENT
  OTHER_EXPENSE
  HISHTALMUT_CONTRIBUTION
  PENSION_CONTRIBUTION
}

enum Frequency {
  MONTHLY
  ANNUAL
  ONE_TIME
}

model CashFlowDetail {
  ledgerItemId String       @id
  ledgerItem   LedgerItem   @relation(fields: [ledgerItemId], references: [id])
  flowType     CashFlowType
  direction    String // IN | OUT
  amount       Decimal      @db.Decimal(18, 4)
  frequency    Frequency
  startDate    DateTime     @db.Date
  endDate      DateTime?    @db.Date
  isGross      Boolean      @default(true) // salary gross vs net
}

enum InsurancePolicyType {
  LIFE
  DISABILITY // ovdan kosher avoda
  HEALTH
  LONG_TERM_CARE
  PROPERTY
  MORTGAGE_LIFE
  OTHER
}

model InsuranceDetail {
  ledgerItemId   String              @id
  ledgerItem     LedgerItem          @relation(fields: [ledgerItemId], references: [id])
  policyType     InsurancePolicyType
  coverageAmount Decimal?            @db.Decimal(18, 4)
  monthlyPremium Decimal?            @db.Decimal(18, 4)
  throughPension Boolean             @default(false)
  insuredMemberId String?
  endDate        DateTime?           @db.Date
}

// ---------------------------------------------------------------------------
// Ingestion: documents, batches, provenance, suspense
// ---------------------------------------------------------------------------

enum ParseStatus {
  UPLOADED
  PARSED
  PARTIALLY_PARSED
  FAILED
  NOT_PARSEABLE // manual-reference only
}

model Document {
  id            String      @id @default(uuid())
  householdId   String
  household     Household   @relation(fields: [householdId], references: [id])
  sha256        String      @unique
  filename      String
  mimeType      String
  docType       String? // PENSION_REPORT | MISLAKA | BANK_STATEMENT | BROKERAGE_STATEMENT | MORTGAGE_SCHEDULE | TAX_106 | OTHER
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  periodStart   DateTime?   @db.Date
  periodEnd     DateTime?   @db.Date
  parseStatus   ParseStatus @default(UPLOADED)
  storageKey    String // path on document volume
  uploadedAt    DateTime    @default(now())

  batches    ImportBatch[]
  valuations Valuation[]
}

enum BatchStatus {
  RUNNING
  COMPLETED
  FAILED
}

model ImportBatch {
  id             String      @id @default(uuid())
  documentId     String?
  document       Document?   @relation(fields: [documentId], references: [id])
  adapterId      String // e.g. "il-pension-annual-pdf", "generic-csv", "manual"
  adapterVersion String
  status         BatchStatus @default(RUNNING)
  rawPayload     Json // full RawDataPayload as emitted by the adapter (audit/replay)
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?

  importedFields ImportedField[]
  suspenseItems  SuspenseItem[]
  transactions   Transaction[] // M36
}

model ImportedField {
  id               String             @id @default(uuid())
  batchId          String
  batch            ImportBatch        @relation(fields: [batchId], references: [id])
  ledgerItemId     String?
  ledgerItem       LedgerItem?        @relation(fields: [ledgerItemId], references: [id])
  valuationId      String?
  valuation        Valuation?         @relation(fields: [valuationId], references: [id])
  fieldPath        String // canonical field this populated, e.g. "accountDetail.managementFeePct"
  originalValue    String // verbatim as extracted (pre-normalization)
  originalCurrency String?            @db.Char(3)
  importDate       DateTime           @default(now())
  confidence       Int
  verification     VerificationStatus @default(UNVERIFIED)
  lastUpdate       DateTime           @updatedAt
}

enum SuspenseStatus {
  PENDING
  RESOLVED
  DISCARDED
}

model SuspenseItem {
  id                   String         @id @default(uuid())
  batchId              String
  batch                ImportBatch    @relation(fields: [batchId], references: [id])
  rawData              Json // preserved verbatim
  reason               String // UNKNOWN_ACCOUNT_TYPE | UNMAPPABLE_FIELD | AMBIGUOUS_OWNER | ...
  status               SuspenseStatus @default(PENDING)
  resolvedLedgerItemId String?
  resolvedLedgerItem   LedgerItem?    @relation("resolution", fields: [resolvedLedgerItemId], references: [id])
  resolutionNote       String?
  createdAt            DateTime       @default(now())
  resolvedAt           DateTime?
}

// ---------------------------------------------------------------------------
// Registry: versioned tax matrices + assumptions. Immutable versions.
// ---------------------------------------------------------------------------

model TaxRuleSet {
  id          String   @id @default(uuid())
  country     String   @default("IL")
  taxYear     Int
  ruleType    String // INCOME_TAX_BRACKETS | CAPITAL_GAINS | HISHTALMUT_CEILING | PENSION_DEDUCTION_CEILINGS | BITUACH_LEUMI | PURCHASE_TAX | ...
  version     Int
  payload     Json // the versioned configuration matrix
  source      String // citation: law/circular/official publication
  /** D5: owner has reviewed and confirmed these figures (separate from the immutable versioned payload). */
  ownerReviewed Boolean @default(false)
  publishedAt DateTime @default(now())

  @@unique([country, taxYear, ruleType, version])
}

model Assumption {
  id            String    @id @default(uuid())
  householdId   String? // null = system default; set = household override
  household     Household? @relation(fields: [householdId], references: [id])
  key           String // e.g. "expected_real_return_equity", "inflation_il", "priority_weights"
  version       Int
  value         Json
  unit          String? // PCT | ILS | RATIO | ...
  description   String
  source        String // CONSERVATIVE_DEFAULT | USER | ...
  effectiveFrom DateTime  @default(now())

  recommendationPins RecommendationAssumption[]

  @@unique([householdId, key, version])
}

// ---------------------------------------------------------------------------
// Goals
// ---------------------------------------------------------------------------

enum GoalType {
  EMERGENCY_FUND
  RETIREMENT
  CHILDREN_EDUCATION
  PROPERTY_PURCHASE
  INVESTMENT_PROPERTY
  FINANCIAL_INDEPENDENCE
  LIFESTYLE
  LEGACY
  INHERITANCE
  PHILANTHROPY
  OTHER
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

model Goal {
  id              String     @id @default(uuid())
  householdId     String
  household       Household  @relation(fields: [householdId], references: [id])
  type            GoalType
  name            String
  priority        Int // 1 = highest
  targetDate      DateTime?  @db.Date
  requiredFunding Decimal?   @db.Decimal(18, 4)
  /** Income mode (FI/RETIREMENT): desired monthly income; effective required funding is DERIVED at read time from goal_projection_real_return_pct, so it tracks assumption changes. */
  targetMonthlyIncome Decimal? @db.Decimal(18, 4)
  currency        String     @db.Char(3)
  riskTolerance   String // LOW | MEDIUM | HIGH
  status          GoalStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())

  dependsOn    GoalDependency[] @relation("dependent")
  dependedOnBy GoalDependency[] @relation("prerequisite")
  impacts      RecommendationGoal[]
  earmarkedItems LedgerItem[]     @relation("GoalEarmark")
}

model GoalDependency {
  goalId         String
  goal           Goal   @relation("dependent", fields: [goalId], references: [id])
  dependsOnGoalId String
  dependsOnGoal  Goal   @relation("prerequisite", fields: [dependsOnGoalId], references: [id])

  @@id([goalId, dependsOnGoalId])
}

// ---------------------------------------------------------------------------
// Strategy: recommendations, explainability, decision journal
// ---------------------------------------------------------------------------

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  IMPLEMENTED
  SUPERSEDED
  INVALIDATED // assumption/registry change
}

model Recommendation {
  id                    String               @id @default(uuid())
  householdId           String
  household             Household            @relation(fields: [householdId], references: [id])
  snapshotId            String
  snapshot              HouseholdSnapshot    @relation(fields: [snapshotId], references: [id])
  engineVersion         String
  type                  String // INCREASE_RETIREMENT_ALLOCATION | REDUCE_CASH | IMPROVE_GEO_DIVERSIFICATION | ...
  title                 String
  titleHe               String?
  rationale             Json // structured: { why, benefits[], risks[], tradeoffs[], taxImplications, liquidityImplications, timeHorizon, sensitivity, alternatives[], expectedImpact }
  rationaleHe           Json? // same structure in Hebrew; null on pre-M10 rows (UI falls back to rationale)
  actionItems           Json? // M23c: { en: string[], he: string[] } computed steps; null on pre-M23 rows
  confidenceScore       Int // 0-100
  dataCompletenessScore Int // 0-100
  priorityScore         Decimal              @db.Decimal(8, 4)
  status                RecommendationStatus @default(PROPOSED)
  generatedAt           DateTime             @default(now())

  // --- M36: operational extension (all additive; every pre-M36 row stays valid) ---
  origin            RecommendationOrigin @default(STRATEGIC)
  cadence           ActionCadence        @default(ONE_TIME)
  dueDate           DateTime?            @db.Date
  expiresAt         DateTime?            @db.Date
  difficulty        ActionDifficulty?
  reversibility     Reversibility?
  impactMonthlyBase Decimal?             @db.Decimal(18, 4)
  impactAnnualBase  Decimal?             @db.Decimal(18, 4)
  impactEoyBase     Decimal?             @db.Decimal(18, 4)
  operatingPeriodId String?
  calendarEventId   String?

  assumptionPins RecommendationAssumption[]
  goalImpacts    RecommendationGoal[]
  evidence       RecommendationEvidence[]
  journal        DecisionJournalEntry[]

  dependsOn    RecommendationDependency[] @relation("dependent")
  dependents   RecommendationDependency[] @relation("prerequisite")
  actionEvents ActionEvent[]

  @@index([householdId, origin, status])
  @@index([householdId, dueDate])
}

model RecommendationAssumption {
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id])
  assumptionId     String
  assumption       Assumption     @relation(fields: [assumptionId], references: [id])

  @@id([recommendationId, assumptionId])
}

model RecommendationGoal {
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id])
  goalId           String
  goal             Goal           @relation(fields: [goalId], references: [id])
  impactDescription String

  @@id([recommendationId, goalId])
}

model RecommendationEvidence {
  id               String         @id @default(uuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id])
  ledgerItemId     String?
  ledgerItem       LedgerItem?    @relation(fields: [ledgerItemId], references: [id])
  description      String
}

model DecisionJournalEntry {
  id                 String         @id @default(uuid())
  recommendationId   String
  recommendation     Recommendation @relation(fields: [recommendationId], references: [id])
  decision           String // ACCEPTED | REJECTED | DEFERRED
  decidedAt          DateTime       @default(now())
  decidedBy          String // family member name (shared login)
  implementationDate DateTime?      @db.Date
  expectedOutcome    String?
  actualOutcome      String? // filled later by monitoring/user
  notes              String?
}

// ---------------------------------------------------------------------------
// Scenario, Snapshot, Monitoring, Audit
// ---------------------------------------------------------------------------

model Scenario {
  id                 String    @id @default(uuid())
  householdId        String
  household          Household @relation(fields: [householdId], references: [id])
  name               String
  type               String // RETIRE_EARLIER | JOB_LOSS | MARKET_CRASH | HIGH_INFLATION | REFINANCE | ...
  parameterOverrides Json // { assumptionKey: overrideValue }
  resultSnapshot     Json? // computed projection results
  baselineSnapshotId String?
  createdAt          DateTime  @default(now())
}

enum SnapshotKind {
  SCHEDULED
  PRE_STRATEGY
  MANUAL
}

model AllocationPlan {
  id            String               @id @default(uuid())
  householdId   String
  household     Household            @relation(fields: [householdId], references: [id])
  snapshotId    String
  snapshot      HouseholdSnapshot    @relation(fields: [snapshotId], references: [id])
  engineVersion String
  plan          Json // M26: DeploymentPlans — three variants, bilingual steps + narratives
  chosenVariant String? // last preset applied (informational)
  stepDecisions Json    @default("{}") // legacy (M26 per-step decisions)
  workingPlan   Json    @default("{}") // M27: { [candidateId]: { enabled: boolean, amount: number } } — the household's edited plan
  status        AllocationPlanStatus @default(PROPOSED)
  createdAt     DateTime             @default(now())
  approvedAt    DateTime?
  note          String?

  @@index([householdId, createdAt])
}

model HouseholdSnapshot {
  id            String       @id @default(uuid())
  householdId   String
  household     Household    @relation(fields: [householdId], references: [id])
  kind          SnapshotKind
  schemaVersion Int
  payload       Json // denormalized full household graph at takenAt
  takenAt       DateTime     @default(now())

  recommendations Recommendation[]
  monitoringRuns  MonitoringRun[] @relation("monitoringSnapshot")

  @@index([householdId, takenAt])
  allocationPlans AllocationPlan[]
}

model FxRate {
  id     String   @id @default(uuid())
  from   String   @db.Char(3)
  to     String   @db.Char(3)
  rate   Decimal  @db.Decimal(18, 8)
  asOf   DateTime @db.Date
  source String // BOI | MANUAL | ...

  @@unique([from, to, asOf, source])
}

model AuditEvent {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  actor       String // user email or "system"
  eventType   String // domain event name
  entity      String
  entityId    String
  payload     Json
  at          DateTime  @default(now())


  @@index([householdId, at])
}

// --- M9 Monitoring (Phase 4) -----------------------------------------------

enum DriftSeverity {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum MonitoringAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// One monitoring cycle: a SCHEDULED snapshot, compared against the strategy
/// baseline (drift) and swept for staleness. Produced by apps/worker (cron) or
/// a manual trigger. Immutable record of what monitoring observed and when.
model MonitoringRun {
  id                 String            @id @default(uuid())
  householdId        String
  household          Household         @relation(fields: [householdId], references: [id])
  snapshotId         String
  snapshot           HouseholdSnapshot @relation("monitoringSnapshot", fields: [snapshotId], references: [id])
  baselineSnapshotId String? // strategy baseline compared against (null before first strategy run)
  trigger            String // CRON | MANUAL
  severity           DriftSeverity     @default(NONE)
  driftReport        Json // structured DriftReport (findings + deltas)
  stalenessReport    Json // { swept: [...itemIds], evaluated, thresholdsByKind }
  itemsFlaggedStale  Int               @default(0)
  createdAt          DateTime          @default(now())

  alerts MonitoringAlert[]

  @@index([householdId, createdAt])
}

/// An actionable finding surfaced by a monitoring run. Acknowledged/resolved by
/// the household; drives the re-evaluation flow (VERIFICATION or STRATEGY re-run).
model MonitoringAlert {
  id          String                @id @default(uuid())
  householdId String
  household   Household             @relation(fields: [householdId], references: [id])
  runId       String
  run         MonitoringRun         @relation(fields: [runId], references: [id])
  kind        String // NET_WORTH_DRIFT | LIQUIDITY_DRIFT | CONCENTRATION_DRIFT | GOAL_FUNDING_DRIFT | STALENESS | ITEM_ADDED | ITEM_REMOVED
  severity    DriftSeverity
  title       String
  titleHe     String?
  detail      Json // structured finding (baseline value, current value, delta, threshold)
  recommendedAction String // REVERIFY | RERUN_STRATEGY | REVIEW
  status      MonitoringAlertStatus @default(OPEN)
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  @@index([householdId, status])
}

// END OF SCHEMA DRAFT

/// M34 — the strategy synthesis artifact (Variant A). A pinned, bilingual
/// high-level plan narrative (achieve / how / expected outcomes) generated on a
/// strategy run from the same snapshot + assumptions the recommendations use.
/// Reproducibility pins live in `pins` (assumption key@version); regenerated only
/// on the next run, so the plan the owner reads is the plan that produced the
/// action items. Relation-free by design (scalar householdId/snapshotId) to keep
/// the migration surface minimal.
model StrategyPlan {
  id            String   @id @default(uuid())
  householdId   String
  snapshotId    String
  engineVersion String
  narrative     Json // { en: { achieve, how, outcomes[] }, he: { ... } }
  metrics       Json // { targetGrowthPct, currentGrowthPct, goalsTotal, goalsFunded, topGoalName, topGoalMonthlySavingILS, actionsTotal, horizonYears }
  pins          Json // reproducibility: [{ key, version }]
  createdAt     DateTime @default(now())

  @@index([householdId, createdAt])
}

// ---------------------------------------------------------------------------
// M36 — Financial Operations & Cash Flow (docs/architecture/07-financial-operations.md)
//
// Design rules enforced here:
//  * Additive only. No existing column/enum value is dropped or renamed.
//  * `Transaction` is the OBSERVATION layer. It is never read by NetWorthCalculator
//    or the strategy analyzers — `CashFlowDetail` streams remain canonical (owner
//    decision D5). Transactions are evidence FOR a stream, not a replacement.
//  * No raw description column exists. Only `descriptionRedacted` is persisted,
//    post-`redact()` (owner decision D3 / §7.1).
// ---------------------------------------------------------------------------

enum RecommendationOrigin {
  STRATEGIC // default — every pre-M36 row
  OPERATIONAL
}

enum ActionCadence {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  EVENT_DRIVEN
}

enum ActionDifficulty {
  TRIVIAL
  EASY
  MODERATE
  HARD
}

enum Reversibility {
  REVERSIBLE
  PARTIALLY_REVERSIBLE
  IRREVERSIBLE
}

/// Dependency edge between action items. Acyclicity is enforced by the domain
/// service, not by the DB (existing convention for cross-aggregate rules).
model RecommendationDependency {
  dependentId    String
  prerequisiteId String
  dependent      Recommendation @relation("dependent", fields: [dependentId], references: [id])
  prerequisite   Recommendation @relation("prerequisite", fields: [prerequisiteId], references: [id])

  @@id([dependentId, prerequisiteId])
  @@index([prerequisiteId])
}

enum BehavioralClass {
  FIXED_CONTRACTUAL // mortgage, arnona, tuition, insurance premiums
  VARIABLE_DISCRETIONARY // dining, entertainment, shopping, travel
  FINANCIAL_DRAG // amlot, FX markup, overdraft interest, dormant subscriptions
  SAVINGS_FLOW // pension / hishtalmut / gemel / standing-order savings — NOT an expense (D7)
  TRANSFER // between own accounts, and card settlements — excluded from income AND expense
}

enum CategoryAxis {
  INCOME
  EXPENSE
}

/// Configurable functional hierarchy (axis 1 of the dual-axis engine). Seeded with
/// an IL-aware default tree; system rows are archivable but never deletable.
model CashFlowCategory {
  id                     String             @id @default(uuid())
  householdId            String
  household              Household          @relation(fields: [householdId], references: [id])
  parentId               String?
  parent                 CashFlowCategory?  @relation("categoryTree", fields: [parentId], references: [id])
  children               CashFlowCategory[] @relation("categoryTree")
  axis                   CategoryAxis
  key                    String // stable slug, e.g. "housing.arnona"
  nameEn                 String
  nameHe                 String
  defaultBehavioralClass BehavioralClass
  /// Bridge to the canonical stream model — lets a category roll up into the
  /// CashFlowType the strategy engine already understands.
  mapsToFlowType         CashFlowType?
  isSystem               Boolean            @default(false)
  isArchived             Boolean            @default(false)
  sortOrder              Int                @default(0)
  createdAt              DateTime           @default(now())

  transactions    Transaction[]
  classifications TransactionClassification[]

  @@unique([householdId, key])
  @@index([householdId, axis, parentId])
}

enum TransactionSource {
  IMPORT
  MANUAL
  DERIVED
}

/// PENDING = seen but not yet settled (e.g. CAL "עסקאות בתהליך קליטה"). Excluded
/// from period computation until BOOKED.
enum TransactionStatus {
  PENDING
  BOOKED
  VOID
}

model Transaction {
  id                  String            @id @default(uuid())
  householdId         String
  household           Household         @relation(fields: [householdId], references: [id])
  importBatchId       String?
  importBatch         ImportBatch?      @relation(fields: [importBatchId], references: [id])
  source              TransactionSource
  status              TransactionStatus @default(BOOKED)
  bookedAt            DateTime          @db.Date
  valueDate           DateTime?         @db.Date
  amount              Decimal           @db.Decimal(18, 4) // signed: negative = outflow
  currency            String            @db.Char(3)
  amountBase          Decimal?          @db.Decimal(18, 4) // null when no FxRate exists — never guessed
  fxRateId            String?
  descriptionRedacted String // post-redaction only; no raw column exists by design
  merchantKey         String? // normalised, Hebrew-aware
  counterpartyMasked  String? // last-4 style, never full

  /// Evidence link back to the canonical stream this observation supports.
  ledgerItemId String?
  ledgerItem   LedgerItem? @relation(fields: [ledgerItemId], references: [id])

  categoryId      String?
  category        CashFlowCategory? @relation(fields: [categoryId], references: [id])
  behavioralClass BehavioralClass? // owner override of the category default

  // --- Israeli instalments (תשלומים). Remaining instalments are committed FUTURE
  // outflows and are emitted as CalendarEvents, not as this month's expense.
  instalmentNumber Int?
  instalmentTotal  Int?
  originalAmount   Decimal? @db.Decimal(18, 4) // סכום עסקה when it differs from סכום חיוב
  /// M40c — the currency of `originalAmount`. Without it that column is ambiguous:
  /// it holds the סכום עסקה for BOTH a foreign purchase (USD) and an instalment plan
  /// (ILS), and the two are indistinguishable by value alone. The FX analyzer needs
  /// to divide only on genuine conversions — reading an instalment as one would imply
  /// a ~92% "markup" on a perfectly ordinary ₪1,200-over-12 purchase.
  originalCurrency String?  @db.Char(3)

  /// Links a bank-side aggregate card settlement to the itemised card statement,
  /// so the two never double-count. See Appendix B.3.
  settlementLinkId     String?
  isRecurringCandidate Boolean @default(false) // e.g. "הוראת קבע" marker
  isDuplicateOf        String?
  externalRef          String? // idempotent re-import key

  createdAt       DateTime                    @default(now())
  classifications TransactionClassification[]

  @@unique([householdId, externalRef])
  @@index([householdId, bookedAt])
  @@index([householdId, categoryId, bookedAt])
  @@index([householdId, merchantKey])
  @@index([householdId, status])
  @@index([settlementLinkId])
}

enum ClassificationStatus {
  AUTO
  SUSPENSE // confidence below operations_classification_min_confidence
  CONFIRMED
  SUPERSEDED
}

/// Full classification history — how a transaction got its dual-axis tags and which
/// rule version decided it. Exactly one non-SUPERSEDED row per transaction.
model TransactionClassification {
  id              String               @id @default(uuid())
  transactionId   String
  transaction     Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId      String
  category        CashFlowCategory     @relation(fields: [categoryId], references: [id])
  behavioralClass BehavioralClass
  confidence      Decimal              @db.Decimal(4, 3) // 0.000–1.000
  method          String // RULE | ALIAS | OWNER | CARRIED_FORWARD | FALLBACK
  ruleVersion     String?
  status          ClassificationStatus @default(AUTO)
  decidedBy       String?
  createdAt       DateTime             @default(now())

  @@index([transactionId, status])
}

enum OperatingPeriodStatus {
  OPEN
  CLOSED
}

/// Source coverage for a period. Never silently COMPLETE — a known-but-unimported
/// source (e.g. the US Chase account) keeps the period PARTIAL and says so.
enum PeriodCoverage {
  COMPLETE
  PARTIAL
  AGGREGATE_ONLY
}

/// A household-month. `computed` freezes the full normalised cash-flow result at
/// close with engineVersion + assumption pins — the same reproducibility contract
/// as StrategyPlan.
model OperatingPeriod {
  id            String                @id @default(uuid())
  householdId   String
  household     Household             @relation(fields: [householdId], references: [id])
  year          Int
  month         Int // 1–12
  status        OperatingPeriodStatus @default(OPEN)
  engineVersion String?
  /// { income{net,byCategory[]}, expenses{byCategory[],byBehavioral{}}, savingsFlows[],
  ///   transfers[], surplusBase, safeToSpend{}, workingCapitalBase, leakageBase, healthScore{} }
  computed      Json?
  pins          Json? // [{ key, version }]

  surplusBase          Decimal?       @db.Decimal(18, 4)
  surplusIsProvisional Boolean        @default(true) // "contains unverified transactions"
  coverage             PeriodCoverage @default(PARTIAL)
  unverifiedCount      Int            @default(0)
  unverifiedAmountBase Decimal?       @db.Decimal(18, 4)
  reviewNote           String?
  closedAt             DateTime?
  createdAt            DateTime       @default(now())

  @@unique([householdId, year, month])
  @@index([householdId, year, month])
}

enum CalendarEventKind {
  TAX_DEADLINE
  BITUACH_LEUMI
  PENSION_WINDOW
  HISHTALMUT_CEILING
  GEMEL_CONTRIBUTION
  MORTGAGE_RESET
  INSURANCE_RENEWAL
  ARNONA
  VEHICLE_LICENSE
  VEHICLE_INSURANCE
  SCHOOL_PAYMENT
  CHILDCARE_PAYMENT
  SALARY_BONUS
  HOLIDAY_SPENDING
  ANNUAL_SUBSCRIPTION
  INSTALMENT // remaining תשלומים on a card purchase
  REVIEW
  OTHER
}

enum CalendarEventStatus {
  SCHEDULED
  DUE
  DONE
  SKIPPED
  EXPIRED
}

model CalendarEvent {
  id                  String              @id @default(uuid())
  householdId         String
  household           Household           @relation(fields: [householdId], references: [id])
  kind                CalendarEventKind
  titleEn             String
  titleHe             String
  dueDate             DateTime            @db.Date
  windowDays          Int                 @default(0)
  amountBase          Decimal?            @db.Decimal(18, 4)
  isCashImpacting     Boolean             @default(false) // feeds the liquidity forecast
  status              CalendarEventStatus @default(SCHEDULED)
  ruleId              String?
  recurringDecisionId String?
  recurringDecision   RecurringDecision?  @relation(fields: [recurringDecisionId], references: [id])
  ledgerItemId        String?
  transactionId       String? // instalment origin
  sourceNote          String? // provenance: STATUTORY | HOUSEHOLD | DERIVED
  completedAt         DateTime?
  createdAt           DateTime            @default(now())

  @@index([householdId, dueDate, status])
  @@index([householdId, kind])
}

/// Recurring operational decision ("review insurance annually"). Emits future
/// CalendarEvents on its cadence; never emits into the past.
model RecurringDecision {
  id            String        @id @default(uuid())
  householdId   String
  household     Household     @relation(fields: [householdId], references: [id])
  key           String // stable slug, e.g. "review.mortgage"
  titleEn       String
  titleHe       String
  cadence       ActionCadence
  anchorDate    DateTime      @db.Date
  leadDays      Int           @default(14)
  isActive      Boolean       @default(true)
  lastEmittedAt DateTime?
  createdAt     DateTime      @default(now())

  events CalendarEvent[]

  @@unique([householdId, key])
}

/// Append-only operational telemetry. The spec's `ActionItemTelemetry` is a COMPUTED
/// projection over this table + DecisionJournalEntry (owner decision D1) — acceptance
/// rate, completion rate, average time-to-completion, dismissal reasons. No metric is
/// stored denormalised.
model ActionEvent {
  id               String                @id @default(uuid())
  householdId      String
  household        Household             @relation(fields: [householdId], references: [id])
  recommendationId String
  recommendation   Recommendation        @relation(fields: [recommendationId], references: [id])
  fromStatus       RecommendationStatus?
  toStatus         RecommendationStatus
  dismissalReason  String? // NOT_RELEVANT | TOO_HARD | DISAGREE | ALREADY_DONE | LATER | OTHER
  note             String?
  actor            String
  at               DateTime              @default(now())

  @@index([householdId, at])
  @@index([recommendationId, at])
}

/// Saved column-mapping profile for the generic tabular adapter — what makes "any
/// bank export" work before an institution-specific adapter exists.
model ImportMappingProfile {
  id            String    @id @default(uuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  name          String
  institutionId String?
  adapterId     String
  /// { headerRow, encoding, dateFormat, amountMode: SIGNED|DEBIT_CREDIT,
  ///   columns: { date, description, amount?, debit?, credit?, currency?, ref?, balance? } }
  mapping       Json
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([householdId, name])
}
