node_modules/
.next/
dist/
.turbo/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store
.railway-config-pull-*/

# Deploy scaffolding delivered to the working folder, never part of the repo.
# Untracked patches were the reason `git am` refused to apply three separate times
# ("untracked working tree files would be overwritten"), which is why every deploy
# script carries a pre-flight block to delete them.
*.patch
deploy-*.ps1
finish-*.ps1
_deploy-archive/

# Local agent/session state -- noise on every git status, and noise is where a
# real modified file hides. Portable copies live in the account skill library.
.claude/

# Staging for files the device bridge cannot delete; remove by hand.
_to_delete/

.claude/settings.local.json

# Playwright session saved by e2e/global-setup.ts (a live login cookie)
e2e/.auth/
playwright-report/
test-results/

# Milestone patch exports (m23..m33 were committed by mistake; WO-7). They are in git history.
/m[0-9]*.patch
