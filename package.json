{
  "name": "wealthos",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint --max-warnings 0 .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "start": "npm run start --workspace=apps/web",
    "postinstall": "npm run generate --workspace=@wealthos/db --if-present && node scripts/ensure-platform-binaries.mjs"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.10.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.62.0"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "postcss": "^8.5.24",
    "brace-expansion": "^5.0.8",
    "sharp": "^0.35.3",
    "fast-uri": "^3.1.4",
    "@hono/node-server": "^2.0.5",
    "valibot": "^1.4.2"
  }
}
